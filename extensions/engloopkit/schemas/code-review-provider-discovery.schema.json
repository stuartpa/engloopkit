{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engloopkit.dev/schemas/code-review-provider-discovery.schema.json",
  "title": "EngLoopKit complete PR review discovery result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "status", "provider", "repository", "pullRequest",
    "actingPrincipal", "sourceRevision", "targetRevision", "iteration",
    "providerHead", "pageCount", "paginationComplete", "continuationToken",
    "threadCount", "threads", "discoveryReceiptId", "mutationPerformed"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "status": { "enum": ["success", "rejected"] },
    "provider": { "$ref": "#/$defs/identity" },
    "repository": { "$ref": "#/$defs/identity" },
    "pullRequest": { "$ref": "#/$defs/identity" },
    "actingPrincipal": { "type": "string", "minLength": 1, "maxLength": 512 },
    "sourceRevision": { "$ref": "#/$defs/revision" },
    "targetRevision": { "$ref": "#/$defs/revision" },
    "iteration": { "$ref": "#/$defs/identity" },
    "providerHead": { "$ref": "#/$defs/revision" },
    "pageCount": { "type": "integer", "minimum": 1 },
    "paginationComplete": { "const": true },
    "continuationToken": { "const": "" },
    "threadCount": { "type": "integer", "minimum": 0 },
    "threads": {
      "type": "array",
      "items": { "$ref": "#/$defs/thread" }
    },
    "discoveryReceiptId": { "type": "string", "minLength": 1 },
    "mutationPerformed": { "const": false }
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S+$" },
    "revision": { "type": "string", "pattern": "^[a-fA-F0-9]{40,64}$" },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comment", "parentComment", "author", "content", "createdAt", "updatedAt", "isDeleted"],
      "properties": {
        "comment": { "$ref": "#/$defs/identity" },
        "parentComment": { "type": "string" },
        "author": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "minLength": 1 },
        "isDeleted": { "type": "boolean" }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread", "rootComment", "status", "anchorPath", "line", "summary", "updatedAt", "comments", "providerState"],
      "properties": {
        "thread": { "$ref": "#/$defs/identity" },
        "rootComment": { "$ref": "#/$defs/identity" },
        "status": { "enum": ["active", "resolved"] },
        "anchorPath": { "type": "string" },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "minLength": 1 },
        "comments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/comment" } },
        "providerState": { "type": "object" }
      }
    }
  }
}
