{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engloopkit.dev/schemas/code-review-provider-inspection.schema.json",
  "title": "EngLoopKit read-only provider inspection result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "provider",
    "repository",
    "pullRequest",
    "thread",
    "sourceRevision",
    "targetRevision",
    "iteration",
    "actingPrincipal",
    "threadStatus",
    "providerHead",
    "operation",
    "packetSha256",
    "addressReceiptSha256",
    "matchCount",
    "mutationPerformed",
    "inspectionReceiptId"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "status": { "enum": ["ready", "rejected"] },
    "provider": { "$ref": "#/$defs/identity" },
    "repository": { "$ref": "#/$defs/identity" },
    "pullRequest": { "$ref": "#/$defs/identity" },
    "thread": { "$ref": "#/$defs/identity" },
    "sourceRevision": { "$ref": "#/$defs/revision" },
    "targetRevision": { "$ref": "#/$defs/revision" },
    "iteration": { "$ref": "#/$defs/identity" },
    "actingPrincipal": { "type": "string", "minLength": 1, "maxLength": 512 },
    "threadStatus": { "enum": ["active", "resolved"] },
    "providerHead": { "$ref": "#/$defs/revision" },
    "operation": { "enum": ["reply", "resolve", "reply-and-resolve"] },
    "packetSha256": { "$ref": "#/$defs/sha256" },
    "addressReceiptSha256": { "$ref": "#/$defs/sha256" },
    "matchCount": { "type": "integer", "minimum": 0 },
    "mutationPerformed": { "const": false },
    "inspectionReceiptId": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "ready" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "matchCount": { "const": 1 } }
      }
    }
  ],
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S+$" },
    "revision": { "type": "string", "pattern": "^[a-fA-F0-9]{40,64}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
