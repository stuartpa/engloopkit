<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SEK model of the EngLoopKit engineering loop. Independent spec of the loop's legal
    stage transitions; `sek explore` turns it into the loop graph and `sek generate`
    emits an xUnit conformance suite that replays legal stage sequences against the SUT
    (EngLoopKit.Core.Loop). Follows SEK's model-project conventions (Nullable/ImplicitUsings
    disabled, AssemblyName Model, exact SpecExplorerKit.Modeling 0.1.3 package).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EngLoopKit.Model</RootNamespace>
    <AssemblyName>Model</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)..\..\.engloop\out\sek-v0.1.3-assets</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpecExplorerKit.Modeling" Version="0.1.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="*.cord" />
  </ItemGroup>

</Project>
